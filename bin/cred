#!/usr/bin/env sh
# cred -- per-repository encrypted credentials.
#
# This is the Python implementation and the default interface on every
# platform. The PowerShell one is bin/cred-ps; both read and write the same
# stores, so which you use is a question about the machine, not the project.
set -e
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if command -v python3 >/dev/null 2>&1; then
    py=python3
elif command -v python >/dev/null 2>&1; then
    py=python
else
    echo "cred: Python 3.8+ was not found." >&2
    echo "" >&2
    echo "Next:" >&2
    echo "  Install Python 3, or use the PowerShell implementation: cred-ps" >&2
    exit 5
fi

exec "$py" "$script_dir/../python/cred.py" "$@"
